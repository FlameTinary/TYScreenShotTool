    "settings.ai.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: lokales OCR. Ein: AI erkennt zuerst Text aus dem Screenshot und analysiert ihn dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, local OCR is used. When on, AI extracts text from the screenshot before analysis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : OCR local. Activé : l’IA extrait d’abord le texte de la capture avant l’analyse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ時はローカル OCR を使用し、オン時は AI が先に画像内の文字を抽出してから分析します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 로컬 OCR을 사용하고, 켜면 AI가 먼저 스크린샷의 문자를 추출한 뒤 분석합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时使用本地 OCR，开启时使用 AI 先识别截图文字再分析。"
          }
        }
      }
    },
