    "settings.hotkey.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützt Modifikatortasten mit Buchstaben, Zahlen, Funktionstasten und Pfeiltasten. Mit Enter bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
